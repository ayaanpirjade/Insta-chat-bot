# Instagram authentication
SESSION_ID=your_instagram_session_id
BOT_USERNAME=manus_automate
OWNER_ID=39285878504
OWNER_IDS=39285878504

# Provider selection: openai, groq, or gemini
AI_PROVIDER=groq
AI_FALLBACK_PROVIDERS=openai,gemini
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
AI_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
# Optional OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Existing providers (optional)
GROQ_API_KEY=
AI_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=

# Bot identity and personality
BOT_NAME=AYAAN AI
BOT_PERSONALITY=friendly
BOT_LANGUAGE=en
# Optional complete override for the AI system prompt
# AI_SYSTEM_PROMPT=
PREFIX=!
BRAND=AYAAN AI • Your Smart Instagram Buddy

# Polling and AI protection
POLL_INTERVAL=2
MAX_HISTORY_MESSAGES=20
AI_COOLDOWN_SECONDS=3
MAX_AI_REQUESTS_PER_MINUTE=10
# Group mode is intentionally ignored for automatic replies; groups require a mention.
GROUP_AI_MODE=false
